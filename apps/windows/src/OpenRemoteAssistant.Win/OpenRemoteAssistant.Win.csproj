<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>OpenRemoteAssistant.Win</RootNamespace>
    <AssemblyName>OpenRemoteAssistantWin</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.3.0</Version>
    <FileVersion>0.3.0.18</FileVersion>
    <AssemblyVersion>0.3.0.18</AssemblyVersion>
    <InformationalVersion>0.3.0-windows-port</InformationalVersion>
    <Company>OpenRemoteAssistant contributors</Company>
    <Product>OpenRemoteAssistant Windows Port</Product>
    <Description>Windows port of OpenRemoteAssistant for the Xiaomi RC003-MS Bluetooth remote</Description>
    <Copyright>GPL-3.0-only</Copyright>
    <PackageProjectUrl>https://github.com/ru-gong/OpenRemoteAssistant</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ru-gong/OpenRemoteAssistant</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <DebugType>none</DebugType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="NAudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
